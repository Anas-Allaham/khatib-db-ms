DATABASE_URL=mongodb://localhost:27017/medical-lab
PORT=3000
# Public origin used to build uploaded image URLs. Defaults to http://localhost:$PORT.
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=dev

TENANT_JWT_SECRET=replace-with-a-long-random-tenant-secret
ACCOUNT_JWT_SECRET=replace-with-a-long-random-account-secret
PATIENT_VERIFICATION_JWT_SECRET=replace-with-a-different-long-random-secret

SWAGGER_USER=
SWAGGER_PASSWORD=

# Super admin created by `seed:account`. Falls back to super-admin-seed.json locally;
# SUPER_ADMIN_PASSWORD is required when NODE_ENV=production or the account is not created.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
